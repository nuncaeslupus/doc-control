{
  "styleset": "house-novel",
  "version": 1,
  "styles": [
    {"id": "Body", "name": "Body", "type": "paragraph", "default": true, "quick": true,
     "run": {"font": "Palatino Serif", "size_pt": 12},
     "paragraph": {"alignment": "both", "indent": {"first_line": 720}, "spacing": {"line": 360, "line_rule": "auto"}}},
    {"id": "ChapterOpen", "name": "Chapter open", "type": "paragraph", "based_on": "Body", "next": "Body", "custom": true, "quick": true,
     "paragraph": {"indent": {"first_line": 0}, "spacing": {"before": 4000}}},
    {"id": "AfterPause", "name": "After pause", "type": "paragraph", "based_on": "Body", "next": "Body", "custom": true, "quick": true,
     "paragraph": {"indent": {"first_line": 0}, "spacing": {"before": 960}}},
    {"id": "BookTitle", "name": "Book title", "type": "paragraph", "based_on": "Body", "next": "Body", "custom": true, "quick": true,
     "run": {"font": "Light Serif", "size_pt": 40, "bold": true},
     "paragraph": {"alignment": "center", "indent": {"first_line": 0}, "spacing": {"before": 3600}}},
    {"id": "PartTitle", "name": "Part title", "type": "paragraph", "based_on": "Body", "next": "ChapterOpen", "custom": true, "quick": true,
     "run": {"size_pt": 48},
     "paragraph": {"alignment": "center", "indent": {"first_line": 0, "right": -56}, "spacing": {"before": 4000, "after": 4000}, "page_break_before": true, "outline_level": 0}},
    {"id": "Heading1", "name": "heading 1", "type": "paragraph", "based_on": "Body", "next": "ChapterOpen", "quick": true,
     "run": {"bold": true, "size_pt": 18},
     "paragraph": {"alignment": "center", "indent": {"first_line": 0}, "spacing": {"before": 2400, "after": 1600}, "outline_level": 0}},
    {"id": "Epigraph", "name": "Epigraph", "type": "paragraph", "based_on": "Body", "next": "Body", "custom": true, "quick": true,
     "run": {"italic": true},
     "paragraph": {"alignment": "left", "indent": {"left": 3402, "right": 125, "first_line": 0}, "spacing": {"before": 2520, "after": 560}}},
    {"id": "EpigraphAuthor", "name": "Epigraph author", "type": "paragraph", "based_on": "Epigraph", "next": "Body", "custom": true, "quick": true,
     "run": {"italic": false, "size_pt": 10},
     "paragraph": {"alignment": "right", "spacing": {"before": 226, "after": 0}, "keep_lines": true}},
    {"id": "SceneBreak", "name": "Scene break", "type": "paragraph", "based_on": "Body", "next": "AfterBreak", "custom": true, "quick": true,
     "run": {"bold": true, "size_pt": 14},
     "paragraph": {"alignment": "center", "indent": {"first_line": 0, "right": 125}, "spacing": {"before": 400, "after": 400}}},
    {"id": "AfterBreak", "name": "After break", "type": "paragraph", "based_on": "Body", "next": "Body", "custom": true, "quick": true,
     "paragraph": {"indent": {"first_line": 0}}},
    {"id": "WorkNote", "name": "Work note", "type": "paragraph", "based_on": "Body", "next": "Body", "custom": true, "quick": true,
     "run": {"bold": true},
     "paragraph": {"alignment": "center", "indent": {"first_line": 0}, "spacing": {"before": 480, "after": 480}, "outline_level": 2}}
  ]
}
