{
  "recipe": "es-aside-dash",
  "version": 1,
  "description": "Hyphen used as the dash of an aside inside a line of dialogue: use an em dash (compound words are left alone)",
  "match": {
    "find": {
      "regex": "^([ \\t]*—.*?)(?:(?<=[    ])[-–](?=[^    \\n])|(?<=[^    \\n])[-–](?=[    .,;:!?]|$))",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": "$1—"
    }
  ],
  "repeat_until_stable": true,
  "max_passes": 10
}
