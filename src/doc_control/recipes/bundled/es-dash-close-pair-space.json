{
  "recipe": "es-dash-close-pair-space",
  "version": 1,
  "description": "Space before the closing dash of an aside (the second dash of each pair in a line of dialogue)",
  "match": {
    "find": {
      "regex": "^([ \\t]*—(?:[^—\\n]*—[^—\\n]*—)*[^—\\n]*—[^—\\n]*?\\S)[    ]+(?=—)",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": "$1"
    }
  ],
  "repeat_until_stable": true,
  "max_passes": 10
}
