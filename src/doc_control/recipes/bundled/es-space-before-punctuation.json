{
  "recipe": "es-space-before-punctuation",
  "version": 1,
  "description": "Space before a closing punctuation mark",
  "match": {
    "find": {
      "regex": "(?<=\\S)[    ]+(?=[.,;:!?…»”’)\\]])",
