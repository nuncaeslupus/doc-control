{
  "recipe": "es-quotes-close",
  "version": 1,
  "description": "Straight double quote that closes a quotation: use »",
  "match": {
    "find": {
      "regex": "(?<=[^\\s(\\[¿¡—])\"(?=[\\s.,;:!?…»”’)\\]—]|$)",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": "»"
    }
  ]
}
