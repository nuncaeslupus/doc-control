{
  "recipe": "es-dialogue-dash",
  "version": 1,
  "description": "A line of dialogue opened with a hyphen, en dash or spaced dash: use a bare em dash glued to the first word",
  "match": {
    "find": {
      "regex": "^([ \\t]*)(?:[-‐‑‒–―]{1,3}|—{2,3}|—(?=[    ]))[    ]*(?=[«“¿¡\\w])",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": "$1—"
    }
  ]
}
