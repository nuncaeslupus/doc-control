{
  "recipe": "es-dash-open-space",
  "version": 1,
  "description": "Space after an opening dash of an aside (the first dash of each pair in a line of dialogue)",
  "match": {
    "find": {
      "regex": "^([ \\t]*—(?:[^—\\n]*—[^—\\n]*—)*[^—\\n]*\\S —)[    ]+(?=[^    .,;:!?…»”’)\\]\\s—])",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": "$1"
    }
  ],
  "repeat_until_stable": true,
  "max_passes": 10
}
