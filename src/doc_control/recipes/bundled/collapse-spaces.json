{
  "recipe": "collapse-spaces",
  "version": 1,
  "description": "Several spaces in a row inside a line: keep one",
  "match": {
    "find": {
      "regex": "(?<=\\S)[    ]{2,}(?=\\S)",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": " "
    }
  ]
}
