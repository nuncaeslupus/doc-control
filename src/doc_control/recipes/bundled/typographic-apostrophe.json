{
  "recipe": "typographic-apostrophe",
  "version": 1,
  "description": "Straight apostrophe between letters: use the typographic one",
  "match": {
    "find": {
      "regex": "(?<=\\w)'(?=\\w)",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": "’"
    }
  ]
}
