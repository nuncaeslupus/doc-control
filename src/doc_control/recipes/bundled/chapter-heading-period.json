{
  "recipe": "chapter-heading-period",
  "version": 1,
  "description": "Remove the full stop after a bare chapter heading ('Chapter 3.')",
  "match": {
    "find": {
      "regex": "^((?:Chapter|CHAPTER|Capítulo|CAPÍTULO|Kapitel|Chapitre) (?:\\d{1,3}|[IVXLCDM]{1,8}))\\.$"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$para",
      "text": "$1"
    }
  ]
}
