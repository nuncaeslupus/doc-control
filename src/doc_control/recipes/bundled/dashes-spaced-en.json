{
  "recipe": "dashes-spaced-en",
  "version": 1,
  "description": "A hyphen with a space on each side between words becomes a spaced en dash",
  "match": {
    "find": {
      "regex": "(?<=\\S) [-‐‒] (?=\\S)"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": " – "
    }
  ]
}
