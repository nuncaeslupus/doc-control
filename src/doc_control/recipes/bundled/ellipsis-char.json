{
  "recipe": "ellipsis-char",
  "version": 1,
  "description": "Three dots, or an ellipsis followed by a full stop: use the single ellipsis character (not in links, addresses or `(...)`)",
  "match": {
    "find": {
      "regex": "(?<!\\S)(?!www\\.|\\S*(?:://|@|mailto:|\\\\)|\\S*[\\w-]\\.[A-Za-z]{2,}/)(\\S*?)(?:(?<!\\.)(?:(?<!\\()\\.\\.\\.|\\.\\.\\.(?!\\)))(?!\\.)|…\\.)",
      "scope": "paragraph"
    }
  },
  "propose": [
    {
      "op": "text.replace",
      "at": "$match",
      "text": "$1…"
    }
  ],
  "repeat_until_stable": true,
  "max_passes": 10
}
